---
import MainLayout from "@/layouts/MainLayout.astro";
import { getMetroId, getUpcomingEvents, getArtistData } from "@utils/concertApi";
import type { Concert } from "@utils/concertApi";

const SONGKICK_KEY = import.meta.env.SONGKICK_API_KEY;
const LASTFM_KEY = import.meta.env.LASTFM_API_KEY;
const ZIP_CODE = "72202";

let concerts: Concert[] = [];
let error: string | null = null;
let metroName = "your area";

if (!SONGKICK_KEY || !LASTFM_KEY) {
  error =
    "Configure SONGKICK_API_KEY and LASTFM_API_KEY in your .env file to load concerts. See .env.example for instructions.";
} else {
  try {
    const metro = await getMetroId(ZIP_CODE, SONGKICK_KEY);
    if (!metro) {
      error = `Could not find a metro area for ZIP ${ZIP_CODE}.`;
    } else {
      metroName = metro.name;
      const events = await getUpcomingEvents(metro.id, SONGKICK_KEY);

      // Deduplicate — one card per artist, earliest event wins
      const seen = new Set<string>();
      const uniqueEvents: any[] = [];
      for (const event of events) {
        const artist = event.performance?.[0]?.artist?.displayName;
        if (!artist || seen.has(artist)) continue;
        seen.add(artist);
        uniqueEvents.push(event);
      }

      // Enrich up to 25 artists in parallel with Last.fm data
      const slice = uniqueEvents.slice(0, 25);
      const enriched = await Promise.allSettled(
        slice.map((event) =>
          getArtistData(event.performance[0].artist.displayName, LASTFM_KEY)
        )
      );

      concerts = slice.map((event, i) => {
        const artistName = event.performance[0].artist.displayName as string;
        const info =
          enriched[i].status === "fulfilled"
            ? enriched[i].value
            : { bio: "", tags: [], imageUrl: "", topTracks: [] };

        return {
          id: String(event.id),
          artistName,
          venue: event.venue?.displayName ?? "TBD",
          city: event.location?.city ?? "",
          date: event.start?.date ?? "",
          time: event.start?.time ?? "",
          ticketUrl: event.uri ?? "",
          bio: info.bio,
          topTracks: info.topTracks,
          tags: info.tags,
          imageUrl: info.imageUrl,
        };
      });
    }
  } catch (err) {
    error = `Failed to load concerts: ${String(err)}`;
  }
}

const allTags = [...new Set(concerts.flatMap((c) => c.tags))].sort();

function formatDate(dateStr: string): string {
  if (!dateStr) return "TBD";
  const d = new Date(dateStr + "T12:00:00");
  return d.toLocaleDateString("en-US", {
    weekday: "short",
    month: "short",
    day: "numeric",
  });
}

function formatTime(timeStr: string): string {
  if (!timeStr) return "";
  const [h, m] = timeStr.split(":");
  const hour = parseInt(h, 10);
  const ampm = hour >= 12 ? "PM" : "AM";
  const h12 = hour % 12 || 12;
  return `${h12}:${m} ${ampm}`;
}

// Deterministic gradient hue from artist name so each card has a unique color
function nameToHue(name: string): number {
  let hash = 0;
  for (let i = 0; i < name.length; i++) {
    hash = ((hash * 31) + name.charCodeAt(i)) & 0xffffffff;
  }
  return Math.abs(hash) % 360;
}

const updatedAt = new Date().toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
});
---

<MainLayout title="Upcoming Concerts · Local Music Discovery">
  <section class="py-16">
    <!-- Page header -->
    <div class="mb-10 text-center">
      <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-yellow-500">
        Live Music
      </p>
      <h1
        class="text-4xl font-bold text-neutral-800 dark:text-neutral-100 sm:text-5xl"
      >
        Upcoming Concerts
      </h1>
      <p class="mt-3 text-neutral-500 dark:text-neutral-400">
        {metroName} area &middot; {updatedAt}
      </p>
    </div>

    {
      error ? (
        <div class="mx-auto max-w-xl rounded-2xl border border-yellow-400/40 bg-yellow-50 p-8 text-center dark:bg-yellow-900/10">
          <svg
            class="mx-auto mb-4 h-10 w-10 text-yellow-500"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"
            />
          </svg>
          <p class="font-medium text-yellow-800 dark:text-yellow-300">{error}</p>
        </div>
      ) : concerts.length === 0 ? (
        <div class="text-center text-neutral-500 dark:text-neutral-400">
          No upcoming concerts found for this area.
        </div>
      ) : (
        <>
          <!-- Genre filter bar -->
          {allTags.length > 0 && (
            <div
              id="filter-bar"
              class="mb-10 flex flex-wrap justify-center gap-2"
            >
              <button
                data-filter-tag="all"
                class="filter-btn rounded-full bg-yellow-400 px-4 py-1.5 text-sm font-semibold text-neutral-900 transition"
              >
                All
              </button>
              {allTags.map((tag) => (
                <button
                  data-filter-tag={tag}
                  class="filter-btn rounded-full bg-neutral-200 px-4 py-1.5 text-sm font-medium text-neutral-700 transition hover:bg-yellow-200 dark:bg-neutral-700 dark:text-neutral-300 dark:hover:bg-neutral-600"
                >
                  {tag}
                </button>
              ))}
            </div>
          )}

          <!-- Concert grid -->
          <div
            id="concert-grid"
            class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
          >
            {concerts.map((concert) => {
              const hue = nameToHue(concert.artistName);
              const hue2 = (hue + 60) % 360;

              return (
                <article
                  data-tags={JSON.stringify(concert.tags)}
                  class="concert-card flex flex-col overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-neutral-200 transition-shadow hover:shadow-md dark:bg-neutral-800 dark:ring-neutral-700"
                >
                  <!-- Artist header: image or gradient -->
                  <div
                    class="relative h-44 w-full overflow-hidden"
                    style={
                      concert.imageUrl
                        ? ""
                        : `background: linear-gradient(135deg, hsl(${hue},55%,38%), hsl(${hue2},55%,28%))`
                    }
                  >
                    {concert.imageUrl && (
                      <img
                        src={concert.imageUrl}
                        alt={concert.artistName}
                        class="h-full w-full object-cover"
                        loading="lazy"
                      />
                    )}
                    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent" />
                    <h2 class="absolute bottom-0 left-0 p-4 text-xl font-bold leading-tight text-white drop-shadow-md">
                      {concert.artistName}
                    </h2>
                  </div>

                  <!-- Card body -->
                  <div class="flex flex-1 flex-col p-5">
                    <!-- Venue + date -->
                    <div class="mb-4 flex flex-col gap-1 text-sm text-neutral-500 dark:text-neutral-400">
                      <span class="flex items-center gap-1.5">
                        <svg class="h-3.5 w-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                        </svg>
                        {concert.venue}{concert.city ? `, ${concert.city}` : ""}
                      </span>
                      <span class="flex items-center gap-1.5">
                        <svg class="h-3.5 w-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
                        </svg>
                        {formatDate(concert.date)}
                        {concert.time && (
                          <span class="text-neutral-400">&middot; {formatTime(concert.time)}</span>
                        )}
                      </span>
                    </div>

                    <!-- Bio -->
                    {concert.bio ? (
                      <p class="mb-4 line-clamp-3 text-sm leading-relaxed text-neutral-600 dark:text-neutral-300">
                        {concert.bio}
                      </p>
                    ) : (
                      <p class="mb-4 text-sm italic text-neutral-400 dark:text-neutral-500">
                        No artist bio available.
                      </p>
                    )}

                    <!-- Top tracks -->
                    {concert.topTracks.length > 0 && (
                      <div class="mb-4">
                        <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-neutral-400 dark:text-neutral-500">
                          Top Songs
                        </p>
                        <ol class="space-y-1.5">
                          {concert.topTracks.map((track, i) => (
                            <li class="flex items-center gap-2.5 text-sm text-neutral-700 dark:text-neutral-300">
                              <span class="flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-yellow-400 text-xs font-bold text-neutral-900">
                                {i + 1}
                              </span>
                              <span class="truncate">{track}</span>
                            </li>
                          ))}
                        </ol>
                      </div>
                    )}

                    <!-- Genre tags -->
                    {concert.tags.length > 0 && (
                      <div class="mt-auto flex flex-wrap gap-1.5 pt-3">
                        {concert.tags.map((tag) => (
                          <span class="rounded-full bg-neutral-100 px-2.5 py-0.5 text-xs font-medium text-neutral-600 dark:bg-neutral-700 dark:text-neutral-300">
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}

                    <!-- Ticket CTA -->
                    {concert.ticketUrl && (
                      <a
                        href={concert.ticketUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="mt-5 inline-flex items-center justify-center gap-2 rounded-full bg-yellow-400 px-5 py-2 text-sm font-semibold text-neutral-900 transition hover:bg-yellow-300 dark:hover:bg-yellow-500"
                      >
                        Get Tickets
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                        </svg>
                      </a>
                    )}
                  </div>
                </article>
              );
            })}
          </div>
        </>
      )
    }
  </section>
</MainLayout>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const cards = document.querySelectorAll<HTMLElement>(".concert-card");

  const ACTIVE = ["bg-yellow-400", "text-neutral-900", "font-semibold"];
  const INACTIVE = [
    "bg-neutral-200",
    "text-neutral-700",
    "dark:bg-neutral-700",
    "dark:text-neutral-300",
    "font-medium",
  ];

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const tag = btn.dataset.filterTag ?? "all";

      filterBtns.forEach((b) => {
        b.classList.remove(...ACTIVE);
        b.classList.add(...INACTIVE);
      });
      btn.classList.add(...ACTIVE);
      btn.classList.remove(...INACTIVE);

      cards.forEach((card) => {
        if (tag === "all") {
          card.style.display = "";
          return;
        }
        const tags: string[] = JSON.parse(card.dataset.tags ?? "[]");
        card.style.display = tags.includes(tag) ? "" : "none";
      });
    });
  });
</script>
