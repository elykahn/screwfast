# Concert Discovery — required API keys
# Copy this file to .env and fill in your keys.

# Songkick API key — request access at https://www.songkick.com/developer/
SONGKICK_API_KEY=your_songkick_key_here

# Last.fm API key — create one at https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_key_here
