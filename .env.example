# Concert Discovery — required API keys
# Copy this file to .env and fill in your keys.

# Ticketmaster Discovery API key — instant free key at https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=your_ticketmaster_key_here

# Last.fm API key — create one at https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_key_here
